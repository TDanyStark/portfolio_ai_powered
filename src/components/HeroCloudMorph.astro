<section class="hero" data-hero-cloud>
    <div class="hero__sky-gradient" aria-hidden="true"></div>
    <div class="hero__mist" aria-hidden="true"></div>

    <div class="hero__depth" data-depth-layer aria-hidden="true"></div>
    <div class="hero__background" data-background-layer aria-hidden="true"></div>

    <div class="hero__content">
        <h1 class="hero__title" aria-label="Daniel Amado Fullstack AI-Powered">
            <span data-title-line>DANIEL AMADO</span>
            <span class="hero__title-subline" data-title-line>FULLSTACK AI-POWERED</span>
        </h1>

        <div class="hero__tech-stage" data-tech-stage aria-hidden="true">
            <div class="hero__tech-fallback" data-tech-fallback hidden>
                <span style="--tech-color: #61dafb;">REACT</span>
                <span style="--tech-color: #3776ab;">PYTHON</span>
                <span style="--tech-color: #111827;">NEXT</span>
                <span style="--tech-color: #264de4;">CSS</span>
                <span style="--tech-color: #e34f26;">HTML</span>
                <span style="--tech-color: #00758f;">MYSQL</span>
            </div>
        </div>
    </div>

    <div class="hero__reveal" data-reveal-layer aria-hidden="true"></div>
</section>

<script>
    // @ts-nocheck
    import { gsap } from 'gsap';

    const hero = document.querySelector('[data-hero-cloud]');

    if (!hero) {
        throw new Error('Hero root was not found.');
    }

    const textures = ['/cloud1.png', '/cloud2.png', '/cloud3.png'];
    const depthLayer = hero.querySelector('[data-depth-layer]');
    const backgroundLayer = hero.querySelector('[data-background-layer]');
    const revealLayer = hero.querySelector('[data-reveal-layer]');
    const techStage = hero.querySelector('[data-tech-stage]');
    const techFallback = hero.querySelector('[data-tech-fallback]');
    const title = hero.querySelector('.hero__title');
    const titleLines = hero.querySelectorAll('[data-title-line]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!depthLayer || !backgroundLayer || !revealLayer || !techStage || !techFallback || !title) {
        throw new Error('Cloud layers are missing in hero markup.');
    }

    const random = (min, max) => min + Math.random() * (max - min);
    const pickTexture = () => textures[Math.floor(Math.random() * textures.length)];
    const techWords = [
        { label: 'REACT', color: '#61dafb' },
        { label: 'PYTHON', color: '#3776ab' },
        { label: 'NEXT', color: '#111827' },
        { label: 'CSS', color: '#264de4' },
        { label: 'HTML', color: '#e34f26' },
        { label: 'MYSQL', color: '#00758f' },
    ];
    const techParticleCount = window.innerWidth <= 720 ? 132 : 184;

    const depthClouds = [];
    const backgroundClouds = [];
    const techParticles = [];
    const wordPointCache = new Map();

    let activeWordIndex = 0;
    let activeSequenceMode = 'assemble';
    let isTransitioningWord = false;
    let stageHoverArmed = true;
    let stageWidth = 0;
    let stageHeight = 0;
    let resizeTimer = 0;

    const sampleCanvas = document.createElement('canvas');
    const sampleContext = sampleCanvas.getContext('2d', { willReadFrequently: true });

    const smoothStep = (edge0, edge1, value) => {
        const clamped = Math.max(0, Math.min(1, (value - edge0) / (edge1 - edge0)));
        return clamped * clamped * (3 - 2 * clamped);
    };

    const shuffle = (list) => {
        const cloned = [...list];

        for (let i = cloned.length - 1; i > 0; i -= 1) {
            const swapIndex = Math.floor(Math.random() * (i + 1));
            const current = cloned[i];
            cloned[i] = cloned[swapIndex];
            cloned[swapIndex] = current;
        }

        return cloned;
    };

    const updateStageSize = () => {
        const bounds = techStage.getBoundingClientRect();
        stageWidth = Math.max(bounds.width, 280);
        stageHeight = Math.max(bounds.height, 120);
        wordPointCache.clear();
    };

    const getWordPoints = (word) => {
        if (!sampleContext) {
            return [];
        }

        const cacheKey = `${word}:${Math.round(stageWidth)}:${Math.round(stageHeight)}:${techParticleCount}`;
        const cached = wordPointCache.get(cacheKey);

        if (cached) {
            return cached;
        }

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        sampleCanvas.width = Math.max(1, Math.round(stageWidth * dpr));
        sampleCanvas.height = Math.max(1, Math.round(stageHeight * dpr));

        sampleContext.setTransform(1, 0, 0, 1, 0, 0);
        sampleContext.clearRect(0, 0, sampleCanvas.width, sampleCanvas.height);
        sampleContext.scale(dpr, dpr);

        let fontSize = stageHeight * 0.68;
        sampleContext.textAlign = 'center';
        sampleContext.textBaseline = 'middle';
        sampleContext.fillStyle = '#ffffff';

        do {
            sampleContext.clearRect(0, 0, stageWidth, stageHeight);
            sampleContext.lineJoin = 'round';
            sampleContext.lineCap = 'round';
            sampleContext.lineWidth = Math.max(8, fontSize * 0.11);
            sampleContext.font = `900 ${fontSize}px Orbitron, sans-serif`;
            sampleContext.strokeText(word, stageWidth / 2, stageHeight / 2);
            fontSize -= 8;
        } while (sampleContext.measureText(word).width > stageWidth * 0.82 && fontSize > stageHeight * 0.34);

        sampleContext.clearRect(0, 0, stageWidth, stageHeight);
        sampleContext.lineJoin = 'round';
        sampleContext.lineCap = 'round';
        sampleContext.lineWidth = Math.max(8, (fontSize + 8) * 0.11);
        sampleContext.font = `900 ${fontSize + 8}px Orbitron, sans-serif`;
        sampleContext.strokeText(word, stageWidth / 2, stageHeight / 2);

        const imageData = sampleContext.getImageData(0, 0, sampleCanvas.width, sampleCanvas.height).data;
        const sampleStep = stageWidth <= 560 ? 8 : 7;
        const points = [];

        for (let y = 0; y < stageHeight; y += sampleStep) {
            for (let x = 0; x < stageWidth; x += sampleStep) {
                const sampleX = Math.min(sampleCanvas.width - 1, Math.floor(x * dpr));
                const sampleY = Math.min(sampleCanvas.height - 1, Math.floor(y * dpr));
                const alpha = imageData[(sampleY * sampleCanvas.width + sampleX) * 4 + 3];

                if (alpha > 110) {
                    points.push({
                        x: x - stageWidth / 2,
                        y: y - stageHeight / 2,
                    });
                }
            }
        }

        const stride = Math.max(1, Math.ceil(points.length / Math.max(1, techParticleCount - 12)));
        const reduced = [];

        for (let index = 0; index < points.length; index += stride) {
            reduced.push(points[index]);
        }

        const output = shuffle(reduced).slice(0, techParticleCount);
        wordPointCache.set(cacheKey, output);
        return output;
    };

    const createTechParticle = () => {
        const particle = document.createElement('span');
        particle.className = 'tech-cloud-particle';
        particle.style.setProperty('--cloud-mask', `url("${pickTexture()}")`);
        techStage.append(particle);

        const state = {
            el: particle,
            x: random(-stageWidth * 0.5, stageWidth * 0.5),
            y: random(-stageHeight * 0.45, stageHeight * 0.45),
            z: random(-1400, -720),
            tx: 0,
            ty: 0,
            tz: 0,
            opacity: 0,
            toOpacity: 0,
            scale: random(0.5, 1.4),
            toScale: 1,
            rotation: random(-120, 120),
            targetRotation: 0,
            driftX: random(2.4, 8.8),
            driftY: random(1.8, 5.6),
            driftSpeed: random(0.65, 1.4),
            phase: random(0, Math.PI * 2),
        };

        techParticles.push(state);
    };

    const seedParticleFromDepth = (particle) => {
        particle.x = random(-stageWidth * 0.68, stageWidth * 0.68);
        particle.y = random(-stageHeight * 0.42, stageHeight * 0.42);
        particle.z = random(-1450, -780);
        particle.opacity = random(0.02, 0.08);
        particle.scale = random(0.34, 1.18);
        particle.rotation = random(-160, 160);
    };

    const seedParticleFromBelow = (particle) => {
        particle.x = random(-stageWidth * 0.72, stageWidth * 0.72);
        particle.y = stageHeight * 1.25 + random(50, 220);
        particle.z = random(-220, 110);
        particle.opacity = random(0.04, 0.12);
        particle.scale = random(0.5, 1.24);
        particle.rotation = random(-120, 120);
    };

    const assignWordTargets = (index, { resetFromBelow = false, resetFromDepth = false } = {}) => {
        activeWordIndex = index;
        activeSequenceMode = 'assemble';

        const word = techWords[index];
        const points = getWordPoints(word.label);
        const stageDepth = Math.max(880, stageWidth * 1.2);

        techParticles.forEach((particle, particleIndex) => {
            if (resetFromBelow) {
                seedParticleFromBelow(particle);
            }

            if (resetFromDepth) {
                seedParticleFromDepth(particle);
            }

            const point = points[particleIndex];
            particle.el.style.setProperty('--particle-color', word.color);

            if (point) {
                particle.tx = point.x + random(-3.2, 3.2);
                particle.ty = point.y + random(-2.8, 2.8);
                particle.tz = random(-18, 34);
                particle.toOpacity = random(0.62, 1);
                particle.toScale = random(0.76, 1.42);
                particle.targetRotation = random(-16, 16);
            } else {
                particle.tx = random(-stageWidth * 0.72, stageWidth * 0.72);
                particle.ty = random(-stageHeight * 0.52, stageHeight * 0.52);
                particle.tz = random(-stageDepth, -stageDepth * 0.45);
                particle.toOpacity = random(0.02, 0.14);
                particle.toScale = random(0.3, 0.82);
                particle.targetRotation = random(-70, 70);
            }
        });
    };

    const assignScatterTargets = (index, direction = 'depth') => {
        activeWordIndex = index;
        activeSequenceMode = 'scatter';

        const word = techWords[index];
        const stageDepth = Math.max(940, stageWidth * 1.34);

        techParticles.forEach((particle) => {
            particle.el.style.setProperty('--particle-color', word.color);
            particle.tx = random(-stageWidth * 0.84, stageWidth * 0.84);
            particle.ty =
                direction === 'below'
                    ? stageHeight * 1.3 + random(60, 260)
                    : random(-stageHeight * 0.74, stageHeight * 0.74);
            particle.tz = direction === 'below' ? random(-160, 120) : random(-stageDepth, -stageDepth * 0.44);
            particle.toOpacity = random(0.01, 0.12);
            particle.toScale = random(0.28, 0.92);
            particle.targetRotation = random(-140, 140);
        });
    };

    const showWordFromBelow = (index) => {
        assignWordTargets(index, { resetFromBelow: true });
    };

    const transitionToNextWord = () => {
        if (isTransitioningWord || prefersReducedMotion) {
            return;
        }

        isTransitioningWord = true;
        stageHoverArmed = false;

        assignScatterTargets(activeWordIndex, 'below');

        window.setTimeout(() => {
            const nextIndex = (activeWordIndex + 1) % techWords.length;
            showWordFromBelow(nextIndex);

            window.setTimeout(() => {
                isTransitioningWord = false;
            }, 1050);
        }, 760);
    };

    const applySequenceLayout = () => {
        if (prefersReducedMotion || techParticles.length === 0) {
            return;
        }

        if (activeSequenceMode === 'scatter') {
            assignScatterTargets(activeWordIndex);
            return;
        }

        assignWordTargets(activeWordIndex);
    };

    updateStageSize();

    const createDepthCloud = () => {
        const cloud = document.createElement('img');
        cloud.className = 'cloud cloud--depth';
        cloud.src = pickTexture();
        cloud.alt = '';
        cloud.decoding = 'async';
        depthLayer.append(cloud);

        const cloudState = {
            el: cloud,
            x: random(-420, 420),
            y: random(-260, 220),
            z: random(-1900, -120),
            vz: random(120, 240),
            vx: random(-38, 38),
            drift: random(0.3, 1.1),
            driftOffset: random(0, Math.PI * 2),
            size: random(320, 620),
            rotation: random(-8, 8),
        };

        cloud.style.width = `${cloudState.size}px`;
        cloud.style.transform = `translate3d(${cloudState.x}px, ${cloudState.y}px, ${cloudState.z}px)`;
        depthClouds.push(cloudState);
    };

    const createBackgroundCloud = () => {
        const cloud = document.createElement('img');
        cloud.className = 'cloud cloud--background';
        cloud.src = pickTexture();
        cloud.alt = '';
        cloud.decoding = 'async';
        backgroundLayer.append(cloud);

        const duration = random(18, 32);
        const delay = random(-16, 0);
        const y = random(8, 90);
        const scale = random(0.7, 1.55);
        const opacity = random(0.14, 0.32);

        gsap.set(cloud, {
            top: `${y}%`,
            scale,
            autoAlpha: opacity,
            xPercent: random(-12, 12),
            rotate: random(-4, 4),
        });

        const peakAlpha = random(0.2, 0.44);

        const tween = gsap.fromTo(
            cloud,
            { xPercent: -138, autoAlpha: 0 },
            {
                xPercent: 148,
                duration,
                delay,
                repeat: -1,
                ease: 'none',
                keyframes: [
                    { autoAlpha: 0, at: 0 },
                    { autoAlpha: peakAlpha, at: 0.2 },
                    { autoAlpha: peakAlpha, at: 0.78 },
                    { autoAlpha: 0, at: 1 },
                ],
            }
        );

        const driftTween = gsap.to(cloud, {
            yPercent: `+=${random(-14, 14)}`,
            duration: random(9, 16),
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut',
        });

        backgroundClouds.push({ tween, fadeTween: driftTween });
    };

    const createRevealCloud = () => {
        const cloud = document.createElement('img');
        cloud.className = 'cloud cloud--reveal';
        cloud.src = pickTexture();
        cloud.alt = '';
        cloud.decoding = 'async';
        revealLayer.append(cloud);

        gsap.set(cloud, {
            left: `${random(10, 90)}%`,
            top: `${random(10, 88)}%`,
            scale: random(0.65, 1.4),
            rotate: random(-18, 18),
            autoAlpha: random(0.42, 0.88),
            xPercent: random(-25, 25),
            yPercent: random(-25, 25),
        });

        gsap.to(cloud, {
            xPercent: `+=${random(-42, 42)}`,
            yPercent: `+=${random(-16, 16)}`,
            duration: random(8, 16),
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut',
        });
    };

    for (let i = 0; i < 26; i += 1) {
        createDepthCloud();
    }

    for (let i = 0; i < 20; i += 1) {
        createBackgroundCloud();
    }

    for (let i = 0; i < 16; i += 1) {
        createRevealCloud();
    }

    if (prefersReducedMotion) {
        techFallback.hidden = false;
    } else {
        techFallback.hidden = true;

        for (let i = 0; i < techParticleCount; i += 1) {
            createTechParticle();
        }

        showWordFromBelow(0);
    }

    const timeline = gsap.timeline({ defaults: { ease: 'power3.out' } });

    timeline
        .fromTo(
            titleLines,
            { yPercent: 120, autoAlpha: 0, filter: 'blur(14px)' },
            { yPercent: 0, autoAlpha: 1, filter: 'blur(0px)', duration: 1.2, stagger: 0.16 },
            0.35
        )
        .fromTo(
            techStage,
            { autoAlpha: 0, y: 28 },
            { autoAlpha: 1, y: 0, duration: 1.5, ease: 'power2.out' },
            0.9
        )
        .fromTo(
            revealLayer,
            { autoAlpha: 0.98 },
            { autoAlpha: 0.2, duration: 2.6, ease: 'sine.out' },
            0.15
        );

    let pointerTargetX = 0;
    let pointerTargetY = 0;
    let pointerCurrentX = 0;
    let pointerCurrentY = 0;

    const onPointerMove = (event) => {
        if (prefersReducedMotion) {
            return;
        }

        const rect = hero.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width;
        const y = (event.clientY - rect.top) / rect.height;

        pointerTargetX = Math.max(-1, Math.min(1, (x - 0.5) * 2));
        pointerTargetY = Math.max(-1, Math.min(1, (y - 0.5) * 2));
    };

    const onPointerLeave = () => {
        pointerTargetX = 0;
        pointerTargetY = 0;
    };

    if (!prefersReducedMotion) {
        hero.addEventListener('pointermove', onPointerMove);
        hero.addEventListener('pointerleave', onPointerLeave);

        techStage.addEventListener('pointerenter', () => {
            if (!stageHoverArmed) {
                return;
            }

            transitionToNextWord();
        });

        techStage.addEventListener('pointerleave', () => {
            stageHoverArmed = true;
        });
    }

    let previousTime = performance.now();
    let animationFrame = 0;

    const updateDepthClouds = (now) => {
        const elapsed = Math.min((now - previousTime) / 1000, 0.06);
        previousTime = now;

        if (!prefersReducedMotion) {
            for (let i = 0; i < depthClouds.length; i += 1) {
                const item = depthClouds[i];
                item.z += item.vz * elapsed;
                item.x += item.vx * elapsed;
                item.x += Math.sin(now * 0.00045 * item.drift + item.driftOffset) * 0.55;
                item.rotation += 0.08 * elapsed;

                if (item.z > 240) {
                    item.z = random(-1900, -1450);
                    item.x = random(-460, 460);
                    item.y = random(-260, 240);
                    item.vx = random(-38, 38);
                    item.vz = random(120, 240);
                    item.rotation = random(-10, 10);
                    item.el.src = pickTexture();
                }

                if (item.x > 550 || item.x < -550) {
                    item.vx *= -1;
                }

                const fadeIn = smoothStep(-1850, -1080, item.z);
                const fadeOut = 1 - smoothStep(10, 230, item.z);
                const depthRatio = Math.max(0, Math.min(1, (item.z + 1900) / 2140));
                const dynamicCeiling = 0.5 + depthRatio * 0.34;
                const opacity = Math.max(0, Math.min(dynamicCeiling, fadeIn * fadeOut * dynamicCeiling));
                item.el.style.opacity = `${opacity}`;
                item.el.style.transform = `translate3d(${item.x}px, ${item.y}px, ${item.z}px) rotate(${item.rotation}deg)`;
            }

            for (let i = 0; i < techParticles.length; i += 1) {
                const particle = techParticles[i];
                const depthRatio = Math.max(0, Math.min(1, 1 - Math.abs(particle.tz) / 1400));
                const driftMultiplier = activeSequenceMode === 'assemble' ? 0.42 : 1;
                const driftX = Math.sin(now * 0.00125 * particle.driftSpeed + particle.phase) * particle.driftX * driftMultiplier;
                const driftY = Math.cos(now * 0.00105 * particle.driftSpeed + particle.phase) * particle.driftY * driftMultiplier;

                particle.x += (particle.tx - particle.x) * 0.086;
                particle.y += (particle.ty - particle.y) * (activeSequenceMode === 'assemble' ? 0.1 : 0.055);
                particle.z += (particle.tz - particle.z) * 0.072;
                particle.opacity += (particle.toOpacity - particle.opacity) * (activeSequenceMode === 'assemble' ? 0.1 : 0.04);
                particle.scale += (particle.toScale - particle.scale) * 0.08;
                particle.rotation += (particle.targetRotation - particle.rotation) * 0.065;

                const opacity = Math.max(0, Math.min(1, particle.opacity * (0.72 + depthRatio * 0.45)));
                particle.el.style.opacity = `${opacity}`;
                particle.el.style.transform = `translate3d(${particle.x + driftX}px, ${particle.y + driftY}px, ${particle.z}px) scale(${particle.scale}) rotate(${particle.rotation}deg)`;
            }

            pointerCurrentX += (pointerTargetX - pointerCurrentX) * 0.08;
            pointerCurrentY += (pointerTargetY - pointerCurrentY) * 0.08;

            const rotateY = pointerCurrentX * 8;
            const rotateX = pointerCurrentY * -6;

            title.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(18px)`;
            titleLines.forEach((line, index) => {
                const depth = index === 0 ? 34 : 20;
                const driftX = pointerCurrentX * (index === 0 ? 10 : 6);
                const driftY = pointerCurrentY * (index === 0 ? 7 : 4);
                line.style.transform = `translate3d(${driftX}px, ${driftY}px, ${depth}px)`;
            });

            techStage.style.transform = `translate3d(${pointerCurrentX * 18}px, ${pointerCurrentY * 10}px, 24px)`;
        }

        animationFrame = requestAnimationFrame(updateDepthClouds);
    };

    animationFrame = requestAnimationFrame(updateDepthClouds);

    const onVisibility = () => {
        if (document.hidden) {
            cancelAnimationFrame(animationFrame);
            return;
        }

        previousTime = performance.now();
        animationFrame = requestAnimationFrame(updateDepthClouds);
    };

    document.addEventListener('visibilitychange', onVisibility);

    const onResize = () => {
        window.clearTimeout(resizeTimer);

        resizeTimer = window.setTimeout(() => {
            updateStageSize();
            applySequenceLayout();
        }, 80);
    };

    if (!prefersReducedMotion) {
        window.addEventListener('resize', onResize);
    }

    window.addEventListener(
        'beforeunload',
        () => {
            document.removeEventListener('visibilitychange', onVisibility);
            hero.removeEventListener('pointermove', onPointerMove);
            hero.removeEventListener('pointerleave', onPointerLeave);
            window.removeEventListener('resize', onResize);
            window.clearTimeout(resizeTimer);
            cancelAnimationFrame(animationFrame);
            backgroundClouds.forEach(({ tween, fadeTween }) => {
                tween.kill();
                fadeTween.kill();
            });
            timeline.kill();
        },
        { once: true }
    );
</script>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;600&display=swap');

    .hero {
        --hero-bg-fallback: #76b9ef;
        --hero-text: #eaf6ff;
        --hero-accent: #7bd2ff;
        position: relative;
        isolation: isolate;
        width: 100%;
        min-height: 100svh;
        overflow: hidden;
        display: grid;
        place-items: center;
        background-color: var(--hero-bg-fallback);
        background-image:
            linear-gradient(180deg, rgba(190, 227, 252, 0.18) 0%, rgba(127, 188, 236, 0.24) 100%),
            url('bg_hero.webp');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        perspective: 1450px;
    }

    .hero__sky-gradient,
    .hero__mist {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .hero__sky-gradient {
        background:
            radial-gradient(circle at 52% 38%, rgba(218, 241, 255, 0.45) 0%, rgba(218, 241, 255, 0) 58%),
            linear-gradient(180deg, rgba(232, 247, 255, 0.2) 0%, rgba(177, 220, 249, 0) 62%);
        z-index: 0;
    }

    .hero__mist {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(9, 33, 56, 0.18) 100%);
        z-index: 1;
    }

    .hero__depth,
    .hero__background,
    .hero__reveal {
        position: absolute;
        inset: 0;
        pointer-events: none;
        transform-style: preserve-3d;
    }

    .hero__depth {
        z-index: 2;
    }

    .hero__background {
        z-index: 3;
        filter: blur(0.7px);
    }

    .hero__content {
        position: relative;
        z-index: 5;
        text-align: center;
        padding-inline: 24px;
        max-width: min(1140px, 100%);
        display: grid;
        justify-items: center;
        gap: clamp(20px, 4vw, 34px);
        transform-style: preserve-3d;
    }

    .hero__content::before {
        content: '';
        position: absolute;
        inset: -18% -10%;
        z-index: -1;
        background: radial-gradient(circle at center, rgba(221, 241, 255, 0.46) 0%, rgba(221, 241, 255, 0.14) 45%, rgba(221, 241, 255, 0) 75%);
        filter: blur(10px);
        pointer-events: none;
    }

    .hero__kicker {
        margin: 0 0 16px;
        font-family: 'Rajdhani', 'Segoe UI', Tahoma, sans-serif;
        font-size: clamp(0.92rem, 1.2vw, 1.15rem);
        letter-spacing: 0.22em;
        color: #0f3558;
        text-shadow: 0 1px 0 rgba(235, 248, 255, 0.8);
        text-transform: uppercase;
        opacity: 0;
    }

    .hero__title {
        margin: 0;
