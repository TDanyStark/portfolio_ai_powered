<section class="hero" data-hero-cloud>
    <div class="hero__sky-gradient" aria-hidden="true"></div>
    <div class="hero__mist" aria-hidden="true"></div>

    <div class="hero__depth" data-depth-layer aria-hidden="true"></div>
    <div class="hero__background" data-background-layer aria-hidden="true"></div>

    <div class="hero__content">
        <h1 class="hero__title" aria-label="Daniel Amado Fullstack AI-Powered">
            <span data-title-line>DANIEL AMADO</span>
            <span class="hero__title-subline" data-title-line>FULLSTACK AI-POWERED</span>
        </h1>

        <div class="hero__tech-stage" data-tech-stage aria-hidden="true">
            <div class="hero__tech-word" data-tech-word></div>
            <div class="hero__tech-fallback" data-tech-fallback hidden>
                <span style="--tech-color: #61dafb;">REACT</span>
                <span style="--tech-color: #3776ab;">PYTHON</span>
                <span style="--tech-color: #111827;">NEXT</span>
                <span style="--tech-color: #264de4;">CSS</span>
                <span style="--tech-color: #e34f26;">HTML</span>
                <span style="--tech-color: #00758f;">MYSQL</span>
            </div>
        </div>
    </div>

    <div class="hero__reveal" data-reveal-layer aria-hidden="true"></div>
</section>

<script>
    // @ts-nocheck
    import { gsap } from 'gsap';
    import * as THREE from 'three';

    const hero = document.querySelector('[data-hero-cloud]');

    if (!hero) {
        throw new Error('Hero root was not found.');
    }

    const textures = ['/cloud1.png', '/cloud2.png', '/cloud3.png'];
    const depthLayer = hero.querySelector('[data-depth-layer]');
    const backgroundLayer = hero.querySelector('[data-background-layer]');
    const revealLayer = hero.querySelector('[data-reveal-layer]');
    const techStage = hero.querySelector('[data-tech-stage]');
    const techWordLayer = hero.querySelector('[data-tech-word]');
    const techFallback = hero.querySelector('[data-tech-fallback]');
    const title = hero.querySelector('.hero__title');
    const titleLines = hero.querySelectorAll('[data-title-line]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!depthLayer || !backgroundLayer || !revealLayer || !techStage || !techWordLayer || !techFallback || !title) {
        throw new Error('Cloud layers are missing in hero markup.');
    }

    const random = (min, max) => min + Math.random() * (max - min);
    const pickTexture = () => textures[Math.floor(Math.random() * textures.length)];
    const techWords = [
        { label: 'REACT', color: '#61dafb' },
        { label: 'PYTHON', color: '#3776ab' },
        { label: 'NEXT', color: '#111827' },
        { label: 'CSS', color: '#264de4' },
        { label: 'HTML', color: '#e34f26' },
        { label: 'MYSQL', color: '#00758f' },
    ];
    const techParticleCount = window.innerWidth <= 720 ? 240 : 380;

    const depthClouds = [];
    const backgroundClouds = [];
    const wordPointCache = new Map();
    const techCycleCalls = [];

    let activeWordIndex = 0;
    let activeSequenceMode = 'assemble';
    let stageWidth = 0;
    let stageHeight = 0;
    let resizeTimer = 0;

    const threeTech = {
        renderer: null,
        scene: null,
        camera: null,
        points: null,
        geometry: null,
        material: null,
        mapTexture: null,
        positions: null,
        targets: null,
        colors: null,
        phases: null,
        driftsX: null,
        driftsY: null,
        colorTarget: new THREE.Color(techWords[0].color),
    };

    const sampleCanvas = document.createElement('canvas');
    const sampleContext = sampleCanvas.getContext('2d', { willReadFrequently: true });

    const smoothStep = (edge0, edge1, value) => {
        const clamped = Math.max(0, Math.min(1, (value - edge0) / (edge1 - edge0)));
        return clamped * clamped * (3 - 2 * clamped);
    };

    const updateStageSize = () => {
        const bounds = techStage.getBoundingClientRect();
        stageWidth = Math.max(bounds.width, 280);
        stageHeight = Math.max(bounds.height, 120);
        wordPointCache.clear();
    };

    const getWordPoints = (word) => {
        if (!sampleContext) {
            return [];
        }

        const cacheKey = `${word}:${Math.round(stageWidth)}:${Math.round(stageHeight)}:${techParticleCount}`;
        const cached = wordPointCache.get(cacheKey);

        if (cached) {
            return cached;
        }

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        sampleCanvas.width = Math.max(1, Math.round(stageWidth * dpr));
        sampleCanvas.height = Math.max(1, Math.round(stageHeight * dpr));

        sampleContext.setTransform(1, 0, 0, 1, 0, 0);
        sampleContext.clearRect(0, 0, sampleCanvas.width, sampleCanvas.height);
        sampleContext.scale(dpr, dpr);

        let fontSize = stageHeight * 1.08;
        sampleContext.textAlign = 'center';
        sampleContext.textBaseline = 'middle';

        do {
            sampleContext.clearRect(0, 0, stageWidth, stageHeight);
            sampleContext.font = `900 ${fontSize}px Orbitron, sans-serif`;
            fontSize -= 6;
        } while (sampleContext.measureText(word).width > stageWidth * 0.985 && fontSize > stageHeight * 0.62);

        sampleContext.clearRect(0, 0, stageWidth, stageHeight);
        sampleContext.fillStyle = '#ffffff';
        sampleContext.font = `900 ${fontSize + 10}px Orbitron, sans-serif`;
        sampleContext.fillText(word, stageWidth / 2, stageHeight / 2);

        const imageData = sampleContext.getImageData(0, 0, sampleCanvas.width, sampleCanvas.height).data;
        const sampleStep = stageWidth <= 560 ? 4 : 3;
        const points = [];

        for (let y = 0; y < stageHeight; y += sampleStep) {
            for (let x = 0; x < stageWidth; x += sampleStep) {
                const sampleX = Math.min(sampleCanvas.width - 1, Math.floor(x * dpr));
                const sampleY = Math.min(sampleCanvas.height - 1, Math.floor(y * dpr));
                const alpha = imageData[(sampleY * sampleCanvas.width + sampleX) * 4 + 3];

                if (alpha > 85) {
                    points.push({
                        x: x - stageWidth / 2,
                        y: y - stageHeight / 2,
                    });
                }
            }
        }

        const stride = Math.max(1, Math.ceil(points.length / Math.max(1, techParticleCount)));
        const output = [];

        for (let index = 0; index < points.length; index += stride) {
            output.push(points[index]);

            if (output.length >= techParticleCount) {
                break;
            }
        }

        wordPointCache.set(cacheKey, output);
        return output;
    };

    const ensureThreeTechRendererSize = () => {
        if (!threeTech.renderer || !threeTech.camera) {
            return;
        }

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        threeTech.renderer.setPixelRatio(dpr);
        threeTech.renderer.setSize(stageWidth, stageHeight, false);
        threeTech.camera.aspect = stageWidth / stageHeight;
        threeTech.camera.updateProjectionMatrix();
    };

    const disposeThreeTech = () => {
        if (threeTech.points && threeTech.scene) {
            threeTech.scene.remove(threeTech.points);
        }

        threeTech.geometry?.dispose();
        threeTech.material?.dispose();
        threeTech.mapTexture?.dispose();
        threeTech.renderer?.dispose();

        if (threeTech.renderer?.domElement?.parentElement) {
            threeTech.renderer.domElement.parentElement.removeChild(threeTech.renderer.domElement);
        }

        threeTech.renderer = null;
        threeTech.scene = null;
        threeTech.camera = null;
        threeTech.points = null;
        threeTech.geometry = null;
        threeTech.material = null;
        threeTech.mapTexture = null;
        threeTech.positions = null;
        threeTech.targets = null;
        threeTech.colors = null;
        threeTech.phases = null;
        threeTech.driftsX = null;
        threeTech.driftsY = null;
    };

    const initTechParticles = () => {
        techWordLayer.innerHTML = '';
        disposeThreeTech();

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'high-performance' });
        renderer.setClearAlpha(0);
        renderer.setPixelRatio(dpr);
        renderer.setSize(stageWidth, stageHeight, false);
        renderer.domElement.style.width = '100%';
        renderer.domElement.style.height = '100%';
        renderer.domElement.style.display = 'block';
        renderer.domElement.style.pointerEvents = 'none';
        techWordLayer.append(renderer.domElement);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(44, stageWidth / stageHeight, 1, 4200);
        camera.position.z = Math.max(780, stageWidth * 1.12);

        const geometry = new THREE.BufferGeometry();
        const positions = new Float32Array(techParticleCount * 3);
        const targets = new Float32Array(techParticleCount * 3);
        const colors = new Float32Array(techParticleCount * 3);
        const phases = new Float32Array(techParticleCount);
        const driftsX = new Float32Array(techParticleCount);
        const driftsY = new Float32Array(techParticleCount);

        for (let i = 0; i < techParticleCount; i += 1) {
            const base = i * 3;
            const x = random(-stageWidth * 0.72, stageWidth * 0.72);
            const y = random(-stageHeight * 0.55, stageHeight * 0.55);
            const z = random(-1450, -780);
            positions[base] = x;
            positions[base + 1] = y;
            positions[base + 2] = z;
            targets[base] = x;
            targets[base + 1] = y;
            targets[base + 2] = z;
            colors[base] = threeTech.colorTarget.r;
            colors[base + 1] = threeTech.colorTarget.g;
            colors[base + 2] = threeTech.colorTarget.b;
            phases[i] = random(0, Math.PI * 2);
            driftsX[i] = random(1.8, 8.6);
            driftsY[i] = random(1.1, 5.4);
        }

        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

        const loader = new THREE.TextureLoader();
        const mapTexture = loader.load(pickTexture());
        mapTexture.colorSpace = THREE.SRGBColorSpace;
        mapTexture.minFilter = THREE.LinearFilter;
        mapTexture.magFilter = THREE.LinearFilter;

        const material = new THREE.PointsMaterial({
            size: window.innerWidth <= 720 ? 16 : 20,
            map: mapTexture,
            transparent: true,
            opacity: 0.92,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            alphaTest: 0.06,
            vertexColors: true,
            sizeAttenuation: true,
        });

        const points = new THREE.Points(geometry, material);
        scene.add(points);

        threeTech.renderer = renderer;
        threeTech.scene = scene;
        threeTech.camera = camera;
        threeTech.points = points;
        threeTech.geometry = geometry;
        threeTech.material = material;
        threeTech.mapTexture = mapTexture;
        threeTech.positions = positions;
        threeTech.targets = targets;
        threeTech.colors = colors;
        threeTech.phases = phases;
        threeTech.driftsX = driftsX;
        threeTech.driftsY = driftsY;
    };

    const assignWordTargets = (index, { resetFromBelow = false, resetFromDepth = false } = {}) => {
        activeWordIndex = index;
        activeSequenceMode = 'assemble';

        const word = techWords[index];
        const points = getWordPoints(word.label);
        const stageDepth = Math.max(880, stageWidth * 1.2);
        const positions = threeTech.positions;
        const targets = threeTech.targets;

        if (!positions || !targets) {
            return;
        }

        threeTech.colorTarget.set(word.color);

        for (let particleIndex = 0; particleIndex < techParticleCount; particleIndex += 1) {
            const base = particleIndex * 3;
            if (resetFromBelow) {
                positions[base] = random(-stageWidth * 0.72, stageWidth * 0.72);
                positions[base + 1] = stageHeight * 1.26 + random(42, 220);
                positions[base + 2] = random(-220, 120);
            }

            if (resetFromDepth) {
                positions[base] = random(-stageWidth * 0.68, stageWidth * 0.68);
                positions[base + 1] = random(-stageHeight * 0.42, stageHeight * 0.42);
                positions[base + 2] = random(-1450, -780);
            }

            const point = points[particleIndex];

            if (point) {
                targets[base] = point.x + random(-0.3, 0.3);
                targets[base + 1] = -point.y + random(-0.3, 0.3);
                targets[base + 2] = random(-22, 34);
            } else {
                targets[base] = random(-stageWidth * 0.68, stageWidth * 0.68);
                targets[base + 1] = random(-stageHeight * 0.5, stageHeight * 0.5);
                targets[base + 2] = random(-stageDepth, -stageDepth * 0.45);
            }
        }

        threeTech.geometry?.attributes.position && (threeTech.geometry.attributes.position.needsUpdate = true);
    };

    const assignScatterTargets = (index, direction = 'depth') => {
        activeWordIndex = index;
        activeSequenceMode = 'scatter';

        const word = techWords[index];
        const stageDepth = Math.max(940, stageWidth * 1.34);

        const targets = threeTech.targets;

        if (!targets) {
            return;
        }

        threeTech.colorTarget.set(word.color);

        for (let i = 0; i < techParticleCount; i += 1) {
            const base = i * 3;
            targets[base] = random(-stageWidth * 0.84, stageWidth * 0.84);
            targets[base + 1] =
                direction === 'below'
                    ? stageHeight * 1.3 + random(60, 260)
                    : random(-stageHeight * 0.74, stageHeight * 0.74);
            targets[base + 2] = direction === 'below' ? random(-160, 120) : random(-stageDepth, -stageDepth * 0.44);
        }
    };

    const clearTechCycle = () => {
        while (techCycleCalls.length > 0) {
            techCycleCalls.pop()?.kill();
        }
    };

    const scheduleTechCycle = () => {
        const holdCall = gsap.delayedCall(2.15, () => {
            const scatterDirection = activeWordIndex % 2 === 0 ? 'depth' : 'below';
            assignScatterTargets(activeWordIndex, scatterDirection);

            const nextCall = gsap.delayedCall(0.95, () => {
                const nextIndex = (activeWordIndex + 1) % techWords.length;
                assignWordTargets(nextIndex, {
                    resetFromBelow: scatterDirection === 'below',
                    resetFromDepth: scatterDirection === 'depth',
                });
                scheduleTechCycle();
            });

            techCycleCalls.push(nextCall);
        });

        techCycleCalls.push(holdCall);
    };

    updateStageSize();

    const createDepthCloud = () => {
        const cloud = document.createElement('img');
        cloud.className = 'cloud cloud--depth';
        cloud.src = pickTexture();
        cloud.alt = '';
        cloud.decoding = 'async';
        depthLayer.append(cloud);

        const cloudState = {
            el: cloud,
            x: random(-420, 420),
            y: random(-260, 220),
            z: random(-1900, -120),
            vz: random(120, 240),
            vx: random(-38, 38),
            drift: random(0.3, 1.1),
            driftOffset: random(0, Math.PI * 2),
            size: random(320, 620),
            rotation: random(-8, 8),
        };

        cloud.style.width = `${cloudState.size}px`;
        cloud.style.transform = `translate3d(${cloudState.x}px, ${cloudState.y}px, ${cloudState.z}px)`;
        depthClouds.push(cloudState);
    };

    const createBackgroundCloud = () => {
        const cloud = document.createElement('img');
        cloud.className = 'cloud cloud--background';
        cloud.src = pickTexture();
        cloud.alt = '';
        cloud.decoding = 'async';
        backgroundLayer.append(cloud);

        const duration = random(18, 32);
        const delay = random(-16, 0);
        const y = random(8, 90);
        const scale = random(0.7, 1.55);
        const opacity = random(0.14, 0.32);

        gsap.set(cloud, {
            top: `${y}%`,
            scale,
            autoAlpha: opacity,
            xPercent: random(-12, 12),
            rotate: random(-4, 4),
        });

        const peakAlpha = random(0.2, 0.44);

        const tween = gsap.fromTo(
            cloud,
            { xPercent: -138, autoAlpha: 0 },
            {
                xPercent: 148,
                duration,
                delay,
                repeat: -1,
                ease: 'none',
                onUpdate() {
                    const progress = this.progress();
                    let alpha = 0;

                    if (progress > 0.18 && progress < 0.78) {
                        alpha = peakAlpha;
                    } else if (progress <= 0.18) {
                        alpha = peakAlpha * (progress / 0.18);
                    } else {
                        alpha = peakAlpha * Math.max(0, 1 - (progress - 0.78) / 0.22);
                    }

                    cloud.style.opacity = `${alpha}`;
                },
            }
        );

        const driftTween = gsap.to(cloud, {
            yPercent: `+=${random(-14, 14)}`,
            duration: random(9, 16),
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut',
        });

        backgroundClouds.push({ tween, fadeTween: driftTween });
    };

    const createRevealCloud = () => {
        const cloud = document.createElement('img');
        cloud.className = 'cloud cloud--reveal';
        cloud.src = pickTexture();
        cloud.alt = '';
        cloud.decoding = 'async';
        revealLayer.append(cloud);

        gsap.set(cloud, {
            left: `${random(10, 90)}%`,
            top: `${random(10, 88)}%`,
            scale: random(0.65, 1.4),
            rotate: random(-18, 18),
            autoAlpha: random(0.42, 0.88),
            xPercent: random(-25, 25),
            yPercent: random(-25, 25),
        });

        gsap.to(cloud, {
            xPercent: `+=${random(-42, 42)}`,
            yPercent: `+=${random(-16, 16)}`,
            duration: random(8, 16),
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut',
        });
    };

    for (let i = 0; i < 26; i += 1) {
        createDepthCloud();
    }

    for (let i = 0; i < 20; i += 1) {
        createBackgroundCloud();
    }

    for (let i = 0; i < 16; i += 1) {
        createRevealCloud();
    }

    if (prefersReducedMotion) {
        techFallback.hidden = false;
    } else {
        techFallback.hidden = true;
        initTechParticles();
        assignWordTargets(0, { resetFromBelow: true });
        scheduleTechCycle();
    }

    const timeline = gsap.timeline({ defaults: { ease: 'power3.out' } });

    timeline
        .fromTo(
            titleLines,
            { yPercent: 120, autoAlpha: 0, filter: 'blur(14px)' },
            { yPercent: 0, autoAlpha: 1, filter: 'blur(0px)', duration: 1.2, stagger: 0.16 },
            0.35
        )
        .fromTo(
            techStage,
            { autoAlpha: 0, y: 28 },
            { autoAlpha: 1, y: 0, duration: 1.5, ease: 'power2.out' },
            0.9
        )
        .fromTo(
            revealLayer,
            { autoAlpha: 0.98 },
            { autoAlpha: 0.2, duration: 2.6, ease: 'sine.out' },
            0.15
        );

    let pointerTargetX = 0;
    let pointerTargetY = 0;
    let pointerCurrentX = 0;
    let pointerCurrentY = 0;

    const onPointerMove = (event) => {
        if (prefersReducedMotion) {
            return;
        }

        const rect = hero.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width;
        const y = (event.clientY - rect.top) / rect.height;

        pointerTargetX = Math.max(-1, Math.min(1, (x - 0.5) * 2));
        pointerTargetY = Math.max(-1, Math.min(1, (y - 0.5) * 2));
    };

    const onPointerLeave = () => {
        pointerTargetX = 0;
        pointerTargetY = 0;
    };

    if (!prefersReducedMotion) {
        hero.addEventListener('pointermove', onPointerMove);
        hero.addEventListener('pointerleave', onPointerLeave);
    }

    let previousTime = performance.now();
    let animationFrame = 0;

    const updateDepthClouds = (now) => {
        const elapsed = Math.min((now - previousTime) / 1000, 0.06);
        previousTime = now;

        if (!prefersReducedMotion) {
            for (let i = 0; i < depthClouds.length; i += 1) {
                const item = depthClouds[i];
                item.z += item.vz * elapsed;
                item.x += item.vx * elapsed;
                item.x += Math.sin(now * 0.00045 * item.drift + item.driftOffset) * 0.55;
                item.rotation += 0.08 * elapsed;

                if (item.z > 240) {
                    item.z = random(-1900, -1450);
                    item.x = random(-460, 460);
                    item.y = random(-260, 240);
                    item.vx = random(-38, 38);
                    item.vz = random(120, 240);
                    item.rotation = random(-10, 10);
                }

                if (item.x > 550 || item.x < -550) {
                    item.vx *= -1;
                }

                const fadeIn = smoothStep(-1850, -1080, item.z);
                const fadeOut = 1 - smoothStep(10, 230, item.z);
                const depthRatio = Math.max(0, Math.min(1, (item.z + 1900) / 2140));
                const dynamicCeiling = 0.5 + depthRatio * 0.34;
                const opacity = Math.max(0, Math.min(dynamicCeiling, fadeIn * fadeOut * dynamicCeiling));
                item.el.style.opacity = `${opacity}`;
                item.el.style.transform = `translate3d(${item.x}px, ${item.y}px, ${item.z}px) rotate(${item.rotation}deg)`;
            }

            if (threeTech.positions && threeTech.targets && threeTech.colors) {
                const positionEase = activeSequenceMode === 'assemble' ? 0.2 : 0.1;
                const driftMultiplier = activeSequenceMode === 'assemble' ? 0.15 : 0.9;

                for (let i = 0; i < techParticleCount; i += 1) {
                    const base = i * 3;
                    const phase = threeTech.phases[i];
                    const driftX = Math.sin(now * 0.0013 + phase) * threeTech.driftsX[i] * driftMultiplier;
                    const driftY = Math.cos(now * 0.001 + phase) * threeTech.driftsY[i] * driftMultiplier;

                    const targetX = threeTech.targets[base] + driftX;
                    const targetY = threeTech.targets[base + 1] + driftY;
                    const targetZ = threeTech.targets[base + 2];

                    threeTech.positions[base] += (targetX - threeTech.positions[base]) * positionEase;
                    threeTech.positions[base + 1] += (targetY - threeTech.positions[base + 1]) * (positionEase + 0.02);
                    threeTech.positions[base + 2] += (targetZ - threeTech.positions[base + 2]) * 0.08;

                    threeTech.colors[base] += (threeTech.colorTarget.r - threeTech.colors[base]) * 0.08;
                    threeTech.colors[base + 1] += (threeTech.colorTarget.g - threeTech.colors[base + 1]) * 0.08;
                    threeTech.colors[base + 2] += (threeTech.colorTarget.b - threeTech.colors[base + 2]) * 0.08;
                }

                threeTech.geometry.attributes.position.needsUpdate = true;
                threeTech.geometry.attributes.color.needsUpdate = true;

                if (threeTech.points) {
                    threeTech.points.rotation.y += (pointerCurrentX * 0.26 - threeTech.points.rotation.y) * 0.08;
                    threeTech.points.rotation.x += (pointerCurrentY * -0.2 - threeTech.points.rotation.x) * 0.08;
                    threeTech.points.position.z += ((activeSequenceMode === 'assemble' ? 12 : -6) - threeTech.points.position.z) * 0.06;
                }

                if (threeTech.camera) {
                    threeTech.camera.position.x += (pointerCurrentX * 48 - threeTech.camera.position.x) * 0.08;
                    threeTech.camera.position.y += (pointerCurrentY * -28 - threeTech.camera.position.y) * 0.08;
                    threeTech.camera.lookAt(0, 0, 0);
                }

                threeTech.renderer?.render(threeTech.scene, threeTech.camera);
            }

            pointerCurrentX += (pointerTargetX - pointerCurrentX) * 0.08;
            pointerCurrentY += (pointerTargetY - pointerCurrentY) * 0.08;

            const rotateY = pointerCurrentX * 8;
            const rotateX = pointerCurrentY * -6;

            title.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(18px)`;
            titleLines.forEach((line, index) => {
                const depth = index === 0 ? 34 : 20;
                const driftX = pointerCurrentX * (index === 0 ? 10 : 6);
                const driftY = pointerCurrentY * (index === 0 ? 7 : 4);
                line.style.transform = `translate3d(${driftX}px, ${driftY}px, ${depth}px)`;
            });

            techStage.style.transform = `translate3d(${pointerCurrentX * 18}px, ${pointerCurrentY * 10}px, 24px)`;
        }

        animationFrame = requestAnimationFrame(updateDepthClouds);
    };

    animationFrame = requestAnimationFrame(updateDepthClouds);

    const onVisibility = () => {
        if (document.hidden) {
            cancelAnimationFrame(animationFrame);
            return;
        }

        previousTime = performance.now();
        animationFrame = requestAnimationFrame(updateDepthClouds);
    };

    document.addEventListener('visibilitychange', onVisibility);

    const onResize = () => {
        window.clearTimeout(resizeTimer);

        resizeTimer = window.setTimeout(() => {
            updateStageSize();

            if (!prefersReducedMotion) {
                clearTechCycle();
                ensureThreeTechRendererSize();
                assignWordTargets(activeWordIndex, { resetFromBelow: true, resetFromDepth: true });
                scheduleTechCycle();
            }
        }, 80);
    };

    if (!prefersReducedMotion) {
        window.addEventListener('resize', onResize);
    }

    window.addEventListener(
        'beforeunload',
        () => {
            document.removeEventListener('visibilitychange', onVisibility);
            hero.removeEventListener('pointermove', onPointerMove);
            hero.removeEventListener('pointerleave', onPointerLeave);
            window.removeEventListener('resize', onResize);
            window.clearTimeout(resizeTimer);
            cancelAnimationFrame(animationFrame);
            clearTechCycle();
            disposeThreeTech();
            backgroundClouds.forEach(({ tween, fadeTween }) => {
                tween.kill();
                fadeTween.kill();
            });
            timeline.kill();
        },
        { once: true }
    );
</script>

