<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daniel Amado - Hero</title>
    <style>
        /* === ESTILOS GLOBALES === */
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #030303; /* Cielo nocturno profundo */
            font-family: 'Inter', -apple-system, sans-serif;
        }

        /* === CAPA 1: VIDEO OVERLAY === */
        #intro-video-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #000000;
            z-index: 30;
            pointer-events: none;
        }

        #intro-video {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Asegura que el video cubra toda la pantalla sin deformarse */
        }

        /* === CAPA 2: THREE.JS CANVAS === */
        #webgl-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
        }

        /* === CAPA 3: INTERFAZ DE USUARIO === */
        #hero-ui {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 20;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            pointer-events: none; /* Crucial: Deja pasar el mouse hacia el canvas 3D */
            opacity: 0; /* Oculto inicialmente, GSAP lo revelará */
        }

        .hero-title {
            font-size: 8vw;
            font-weight: 900;
            color: rgba(255, 255, 255, 0.9);
            margin: 0;
            letter-spacing: -0.03em;
            line-height: 1;
            text-shadow: 0 0 40px rgba(0, 240, 255, 0.2);
        }

        .hero-subtitle {
            font-size: 2vw;
            font-family: monospace;
            color: #00F0FF;
            margin-top: 10px;
            letter-spacing: 0.2em;
            text-transform: uppercase;
        }
    </style>
</head>
<body>

    <!-- Capa de Video Real -->
    <div class="video-overlay" id="intro-video-container">
        <video id="intro-video" muted playsinline>
            <source src="video.mp4" type="video/mp4" />
        </video>
    </div>

    <!-- El lienzo de las Nubes / Logos -->
    <canvas id="webgl-canvas"></canvas>

    <!-- Tu Título -->
    <div id="hero-ui">
        <h1 class="hero-title">DANIEL AMADO</h1>
        <h2 class="hero-subtitle">FULLSTACK AI-POWERED</h2>
    </div>

    <!-- Importamos Three.js y GSAP desde CDNs (En Astro usarías npm install) -->
    <script type="module">
        import * as THREE from 'https://cdn.skypack.dev/three@0.136.0';
        import gsap from 'https://cdn.skypack.dev/gsap@3.10.4';

        // ==========================================
        // 1. CONFIGURACIÓN BÁSICA DE THREE.JS
        // ==========================================
        const canvas = document.getElementById('webgl-canvas');
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 120;

        // ==========================================
        // 2. TEXTURAS DE NUBES
        // ==========================================
        const textureLoader = new THREE.TextureLoader();
        // Usamos una textura de humo pública muy popular en Three.js para darle el efecto de nube real
        // Puedes cambiar esta URL por el asset generado con IA
        const cloudTexture = textureLoader.load('cloud1.png');

        // ==========================================
        // 3. GENERACIÓN DE DATOS (MOLDE DE LOS LOGOS)
        // ==========================================
        function getLogoCoordinates() {
            const tempCanvas = document.createElement('canvas');
            const ctx = tempCanvas.getContext('2d');
            tempCanvas.width = 1024;
            tempCanvas.height = 512;

            ctx.fillStyle = 'black';
            ctx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
            ctx.fillStyle = 'white';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            
            ctx.font = 'bold 60px Arial';
            ctx.fillText('HTML', 200, 150);
            ctx.font = 'bold 70px Arial';
            ctx.fillText('JS', 800, 150);
            ctx.font = '80px Arial';
            ctx.fillText('⚛', 512, 400); 
            ctx.font = 'bold 60px Arial';
            ctx.fillText('PY', 200, 400); 
            ctx.font = 'bold 50px Arial';
            ctx.fillText('NEXT', 800, 400);

            const imgData = ctx.getImageData(0, 0, tempCanvas.width, tempCanvas.height).data;
            const validCoordinates = [];

            // Aumentamos el muestreo (+3 en lugar de +2) para no tener excesivas partículas
            // ya que ahora usan texturas densas de humo
            for (let y = 0; y < tempCanvas.height; y += 3) { 
                for (let x = 0; x < tempCanvas.width; x += 3) {
                    const index = (y * tempCanvas.width + x) * 4;
                    const r = imgData[index];
                    if (r > 128) {
                        const posX = (x / tempCanvas.width - 0.5) * 160;
                        const posY = -(y / tempCanvas.height - 0.5) * 80;
                        validCoordinates.push(new THREE.Vector3(posX, posY, 0));
                    }
                }
            }
            return validCoordinates;
        }

        const targetCoords = getLogoCoordinates();
        // Menos partículas pero más grandes porque ahora son texturas de nubes densas
        const numParticles = 12000; 

        const geometry = new THREE.BufferGeometry();
        const positions = new Float32Array(numParticles * 3);
        const targets = new Float32Array(numParticles * 3);
        const sizes = new Float32Array(numParticles);

        for (let i = 0; i < numParticles; i++) {
            positions[i * 3] = (Math.random() - 0.5) * 400;     
            positions[i * 3 + 1] = (Math.random() - 0.5) * 300; 
            positions[i * 3 + 2] = (Math.random() - 0.5) * 200; 

            const target = targetCoords[Math.floor(Math.random() * targetCoords.length)];
            targets[i * 3] = target.x;
            targets[i * 3 + 1] = target.y;
            targets[i * 3 + 2] = (Math.random() - 0.5) * 8; 

            // Partículas mucho más grandes para parecer nubes (10 a 30 de tamaño relativo)
            sizes[i] = Math.random() * 20.0 + 10.0;
        }

        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('aTarget', new THREE.BufferAttribute(targets, 3));
        geometry.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));

        // ==========================================
        // 4. SHADERS MAGIC (GLSL)
        // ==========================================
        const material = new THREE.ShaderMaterial({
            uniforms: {
                uTime: { value: 0 },
                uProgress: { value: 0 }, 
                uMouse: { value: new THREE.Vector3(-999, -999, 0) }, 
                uColorBase: { value: new THREE.Color('#00F0FF') },
                uCloudTexture: { value: cloudTexture } // Pasamos la textura al Shader
            },
            vertexShader: `
                uniform float uTime;
                uniform float uProgress;
                uniform vec3 uMouse;
                
                attribute vec3 aTarget;
                attribute float aSize;
                
                varying float vAlpha;

                vec3 noise3D(vec3 p) {
                    return vec3(
                        sin(p.y * 10.0 + uTime) * cos(p.z * 5.0 + uTime),
                        sin(p.z * 10.0 + uTime) * cos(p.x * 5.0 + uTime),
                        sin(p.x * 10.0 + uTime) * cos(p.y * 5.0 + uTime)
                    );
                }

                void main() {
                    vec3 finalPos = mix(position, aTarget, uProgress);

                    float distToMouse = distance(finalPos.xy, uMouse.xy);
                    float interactionRadius = 25.0; 
                    
                    if (distToMouse < interactionRadius && uProgress > 0.5) {
                        float force = (interactionRadius - distToMouse) / interactionRadius;
                        vec3 turbulence = noise3D(finalPos * 0.1) * force * 15.0;
                        vec3 push = normalize(finalPos - vec3(uMouse.xy, 0.0)) * force * 10.0;
                        finalPos += turbulence + push;
                    }

                    finalPos.y += sin(uTime * 1.5 + aTarget.x * 0.1) * 0.8 * uProgress;

                    vec4 mvPosition = modelViewMatrix * vec4(finalPos, 1.0);
                    
                    // Incrementamos drásticamente el multiplicador de tamaño para las texturas
                    gl_PointSize = aSize * (300.0 / -mvPosition.z);
                    gl_Position = projectionMatrix * mvPosition;

                    vAlpha = mix(0.1, 0.4, uProgress); // Nubes suaves y semitransparentes
                }
            `,
            fragmentShader: `
                uniform vec3 uColorBase;
                uniform sampler2D uCloudTexture;
                varying float vAlpha;

                void main() {
                    // Mapeamos la textura de nube sobre la partícula
                    vec4 texColor = texture2D(uCloudTexture, gl_PointCoord);
                    
                    // Mezclamos el color base (Azul) con la textura y la opacidad global
                    // El ".r" funciona bien para texturas de humo en escala de grises
                    gl_FragColor = vec4(uColorBase * texColor.rgb, vAlpha * texColor.r);
                }
            `,
            transparent: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending // Para que las nubes se mezclen luminosamente
        });

        const particleSystem = new THREE.Points(geometry, material);
        scene.add(particleSystem);

        // ==========================================
        // 5. INTERACCIÓN DEL MOUSE
        // ==========================================
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0); 
        const targetPoint = new THREE.Vector3();

        window.addEventListener('mousemove', (event) => {
            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
            raycaster.setFromCamera(mouse, camera);
            raycaster.ray.intersectPlane(plane, targetPoint);
            material.uniforms.uMouse.value.copy(targetPoint);
        });

        // ==========================================
        // 6. ANIMACIÓN Y VIDEO LOGIC
        // ==========================================
        const video = document.getElementById('intro-video');
        const videoContainer = document.getElementById('intro-video-container');
        let transitionStarted = false;

        function startMagic() {
            if(transitionStarted) return;
            transitionStarted = true;

            const tl = gsap.timeline();
            tl.to(videoContainer, {
                opacity: 0,
                duration: 2,
                ease: "power2.inOut"
            });
            tl.to("#hero-ui", {
                opacity: 1,
                duration: 2,
                ease: "power2.out"
            }, "-=1.0");
            tl.to(material.uniforms.uProgress, {
                value: 1,
                duration: 5,
                ease: "power3.inOut"
            }, "-=1.5");
        }

        // Intentar reproducir automáticamente
        video.play().catch(e => console.warn("Autoplay prevenido por el navegador. Se necesita interacción.", e));

        // Escuchar el progreso del video (Ej: iniciar 2 segundos antes de que termine)
        video.addEventListener('timeupdate', () => {
            if (video.duration > 0 && video.currentTime >= video.duration - 2) {
                startMagic();
            }
        });

        // Plan de Respaldo: Si el video no carga o da error, iniciamos a los 3 segundos.
        setTimeout(() => {
            if(!transitionStarted) startMagic();
        }, 3000);

        // ==========================================
        // 7. RENDER LOOP Y RESIZE
        // ==========================================
        const clock = new THREE.Clock();
        function animate() {
            requestAnimationFrame(animate);
            material.uniforms.uTime.value = clock.getElapsedTime();
            camera.position.x += (mouse.x * 10 - camera.position.x) * 0.05;
            camera.position.y += (mouse.y * 10 - camera.position.y) * 0.05;
            camera.lookAt(scene.position);
            renderer.render(scene, camera);
        }
        animate();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>