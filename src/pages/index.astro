<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daniel Amado - Hero</title>
    <style>
        :root {
            --sky-top: #78b9f6;
            --sky-mid: #b9dcff;
            --sky-bottom: #e8f4ff;
        }

        html, body {
            margin: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: "Sora", "Segoe UI", sans-serif;
            background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 50%, var(--sky-bottom) 100%);
        }

        .hero {
            position: relative;
            width: 100%;
            height: 100vh;
            overflow: hidden;
        }

        #sky-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
            background-image:
                radial-gradient(circle at 18% 22%, rgba(255, 255, 255, 0.70), transparent 30%),
                radial-gradient(circle at 78% 26%, rgba(255, 255, 255, 0.55), transparent 28%),
                radial-gradient(circle at 60% 72%, rgba(255, 255, 255, 0.45), transparent 36%),
                linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 48%, var(--sky-bottom) 100%);
            background-size: 130% 130%;
            animation: driftSky 24s ease-in-out infinite alternate;
        }

        #sky-bg::after {
            content: "";
            position: absolute;
            inset: -8%;
            background: url('/cloud1.png') center/40% repeat;
            opacity: 0.2;
            mix-blend-mode: screen;
            filter: saturate(0.9) contrast(1.02);
            pointer-events: none;
        }

        #webgl-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        #hero-ui {
            position: absolute;
            inset: 0;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            pointer-events: none;
        }

        .hero-title {
            margin: 0;
            font-size: clamp(2rem, 6vw, 5.75rem);
            letter-spacing: -0.03em;
            color: rgba(22, 37, 56, 0.88);
            text-shadow: 0 10px 28px rgba(255, 255, 255, 0.55);
        }

        .hero-subtitle {
            margin: 0.65rem 0 0;
            font-size: clamp(0.8rem, 1.6vw, 1.3rem);
            letter-spacing: 0.28em;
            text-transform: uppercase;
            color: rgba(27, 52, 81, 0.86);
        }

        @keyframes driftSky {
            from {
                transform: scale(1) translate3d(0, 0, 0);
            }

            to {
                transform: scale(1.08) translate3d(-2.5%, 1.2%, 0);
            }
        }
    </style>
</head>
<body>
    <section class="hero">
        <div id="sky-bg"></div>
        <canvas id="webgl-canvas"></canvas>

        <div id="hero-ui">
            <h1 class="hero-title">DANIEL AMADO</h1>
            <h2 class="hero-subtitle">FULLSTACK AI-POWERED</h2>
        </div>
    </section>

    <script type="module">
        import * as THREE from 'three';
        import { gsap } from 'gsap';

        const canvas = document.getElementById('webgl-canvas');
        const isMobile = window.innerWidth < 768;
        const pairLabels = [
            ['HTML', 'JS'],
            ['REACT', 'PYTHON'],
            ['NODE', 'NEXT']
        ];

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = isMobile ? 140 : 115;

        const cloudTexture = new THREE.TextureLoader().load('/cloud1.png');

        const material = new THREE.ShaderMaterial({
            uniforms: {
                uTime: { value: 0 },
                uProgress: { value: 1 },
                uCloudTexture: { value: cloudTexture },
                uColorBase: { value: new THREE.Color('#ffffff') }
            },
            vertexShader: `
                uniform float uTime;
                uniform float uProgress;

                attribute vec3 aTarget;
                attribute float aSize;

                varying float vAlpha;

                vec3 noise3D(vec3 p) {
                    return vec3(
                        sin(p.y * 9.0 + uTime * 0.65) * cos(p.z * 4.5 + uTime),
                        sin(p.z * 8.0 + uTime * 0.75) * cos(p.x * 4.0 + uTime),
                        sin(p.x * 9.0 + uTime * 0.7) * cos(p.y * 3.5 + uTime)
                    );
                }

                void main() {
                    vec3 chaos = position + noise3D(position * 0.04) * 4.0;
                    vec3 formed = aTarget + noise3D(aTarget * 0.025) * 0.65;
                    vec3 finalPos = mix(chaos, formed, uProgress);

                    vec4 mvPosition = modelViewMatrix * vec4(finalPos, 1.0);
                    gl_PointSize = aSize * (285.0 / -mvPosition.z);
                    gl_Position = projectionMatrix * mvPosition;

                    vAlpha = mix(0.22, 0.56, uProgress);
                }
            `,
            fragmentShader: `
                uniform sampler2D uCloudTexture;
                uniform vec3 uColorBase;
                varying float vAlpha;

                void main() {
                    vec4 smoke = texture2D(uCloudTexture, gl_PointCoord);
                    float alpha = smoke.r * vAlpha;
                    gl_FragColor = vec4(uColorBase, alpha);
                }
            `,
            transparent: true,
            depthWrite: false,
            blending: THREE.NormalBlending
        });

        const numParticles = isMobile ? 7500 : 12500;
        const geometry = new THREE.BufferGeometry();
        const positions = new Float32Array(numParticles * 3);
        const targets = new Float32Array(numParticles * 3);
        const sizes = new Float32Array(numParticles);

        for (let i = 0; i < numParticles; i += 1) {
            positions[i * 3] = (Math.random() - 0.5) * 380;
            positions[i * 3 + 1] = (Math.random() - 0.5) * 250;
            positions[i * 3 + 2] = (Math.random() - 0.5) * 120;
            sizes[i] = isMobile ? Math.random() * 10 + 9 : Math.random() * 12 + 11;
        }

        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('aTarget', new THREE.BufferAttribute(targets, 3));
        geometry.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));

        const particles = new THREE.Points(geometry, material);
        scene.add(particles);

        function buildPairTargets(leftLabel, rightLabel) {
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = 1400;
            tempCanvas.height = 720;
            const ctx = tempCanvas.getContext('2d');
            ctx.fillStyle = 'black';
            ctx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
            ctx.fillStyle = 'white';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            const leftFont = isMobile ? '900 122px Arial Black' : '900 186px Arial Black';
            const rightFont = isMobile ? '900 112px Arial Black' : '900 172px Arial Black';
            const baselineY = isMobile ? 360 : 370;

            ctx.font = leftFont;
            ctx.fillText(leftLabel, tempCanvas.width * 0.29, baselineY);
            ctx.font = rightFont;
            ctx.fillText(rightLabel, tempCanvas.width * 0.71, baselineY);

            const data = ctx.getImageData(0, 0, tempCanvas.width, tempCanvas.height).data;
            const points = [];
            const step = isMobile ? 3 : 2;

            for (let y = 0; y < tempCanvas.height; y += step) {
                for (let x = 0; x < tempCanvas.width; x += step) {
                    const index = (y * tempCanvas.width + x) * 4;
                    if (data[index] > 128) {
                        points.push({
                            x: (x / tempCanvas.width - 0.5) * (isMobile ? 185 : 228),
                            y: -(y / tempCanvas.height - 0.5) * (isMobile ? 108 : 122),
                            z: (Math.random() - 0.5) * 6
                        });
                    }
                }
            }

            return points;
        }

        function assignTargets(left, right) {
            const coords = buildPairTargets(left, right);
            const targetAttr = geometry.getAttribute('aTarget');
            for (let i = 0; i < numParticles; i += 1) {
                const point = coords[Math.floor(Math.random() * coords.length)];
                targetAttr.array[i * 3] = point.x;
                targetAttr.array[i * 3 + 1] = point.y;
                targetAttr.array[i * 3 + 2] = point.z;
            }
            targetAttr.needsUpdate = true;
        }

        let activePair = 0;
        assignTargets(pairLabels[activePair][0], pairLabels[activePair][1]);

        const morph = gsap.timeline({ repeat: -1, repeatDelay: 0.28 });
        morph
            .to(material.uniforms.uProgress, {
                value: 1,
                duration: 1.1,
                ease: 'power2.out'
            })
            .to({}, { duration: 1.3 })
            .to(material.uniforms.uProgress, {
                value: 0,
                duration: 2.05,
                ease: 'power3.inOut',
                onComplete: () => {
                    activePair = (activePair + 1) % pairLabels.length;
                    assignTargets(pairLabels[activePair][0], pairLabels[activePair][1]);
                }
            })
            .to(material.uniforms.uProgress, {
                value: 1,
                duration: 2.35,
                ease: 'power3.out'
            })
            .to({}, { duration: 1.45 });

        const clock = new THREE.Clock();
        function animate() {
            requestAnimationFrame(animate);
            const elapsed = clock.getElapsedTime();
            material.uniforms.uTime.value = elapsed;

            camera.position.x = Math.sin(elapsed * 0.12) * 3.4;
            camera.position.y = Math.cos(elapsed * 0.15) * 1.7;
            camera.lookAt(0, 0, 0);

            renderer.render(scene, camera);
        }

        animate();

        window.addEventListener('resize', () => {
            const mobile = window.innerWidth < 768;
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.position.z = mobile ? 140 : 115;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
        });
    </script>
</body>
</html>